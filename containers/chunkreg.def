Bootstrap: docker
From: @BASE_IMAGE@

# chunkreg with the GPU path: torch, MONAI, anatomix (weights baked in) and the
# pinned FireANTs fork with its fused CUDA ops.
#
# This is a template: do not build it directly. containers/build.sh fills in the
# @...@ placeholders for the chosen CUDA version and builds it:
#     bash containers/build.sh --cuda 12.1
#
# The devel base is deliberate: FireANTs' fused ops are compiled here, and that
# needs nvcc. Python comes from uv rather than the distro, because zarr 3 needs
# 3.11+ and Ubuntu 22.04 ships 3.10. Everything lives under /opt and %post ends
# with a chmod, so the image runs for any uid; a rapidsai-style /opt/conda owned
# by one uid is what broke the BRIDGE jobs.

%labels
    Name chunkreg
    Description Hierarchical chunked co-registration, GPU build
    CUDA @CUDA@
    Torch @TORCH_VERSION@

%files
    @REPO@/pyproject.toml /opt/chunkreg-src/pyproject.toml
    @REPO@/README.md      /opt/chunkreg-src/README.md
    @REPO@/chunkreg       /opt/chunkreg-src/chunkreg

%environment
    export PATH=/opt/venv/bin:$PATH
    # Weights were fetched at build time; compute nodes may have no internet.
    export HF_HOME=/opt/hf
    export HF_HUB_OFFLINE=1
    # A ~/.local site-packages from the host must not shadow the image.
    export PYTHONNOUSERSITE=1
    export PYTHONUNBUFFERED=1

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential git curl ca-certificates
    rm -rf /var/lib/apt/lists/*

    # Python from uv, installed under /opt so it ends up inside the image.
    curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_INSTALL_DIR=/opt/uv UV_NO_MODIFY_PATH=1 sh
    export UV_PYTHON_INSTALL_DIR=/opt/python
    /opt/uv/uv python install 3.12
    /opt/uv/uv venv --python 3.12 --seed /opt/venv
    PIP="/opt/venv/bin/python -m pip"
    $PIP install --no-cache-dir --upgrade pip setuptools wheel

    # torch first, from the index for the image's CUDA. The constraints keep
    # every later install from swapping it for a PyPI build. monai 1.6 wants
    # torch 2.8+, so it is held at the last release that accepts this torch.
    $PIP install --no-cache-dir \
        "torch==@TORCH_VERSION@" "torchvision==@TORCHVISION_VERSION@" \
        --index-url "@TORCH_INDEX@"
    printf '%s\n' \
        "torch==@TORCH_VERSION@" \
        "torchvision==@TORCHVISION_VERSION@" \
        "monai==1.5.2" > /opt/constraints.txt
    export PIP_CONSTRAINT=/opt/constraints.txt

    $PIP install --no-cache-dir "/opt/chunkreg-src[store,io,gpu,qc,viz]"

    # anatomix pins torch==2.13 in its requirements, which none of the builds
    # here can satisfy, so it goes in without deps and its requirements are
    # listed below minus the torch pins. Pinned to a commit because main moves.
    $PIP install --no-cache-dir --no-deps \
        "git+https://github.com/neel-dey/anatomix.git@c67a181e6755b1138c7008017baaaf51cdb76fa3"
    $PIP install --no-cache-dir \
        numpy nibabel scipy scikit-image scikit-learn simpleitk nilearn h5py \
        matplotlib torchio monai tensorboard tqdm natsort huggingface_hub \
        "dynamic-network-architectures==0.4.4"

    # FireANTs, as anatomix's install_fireants.sh does it: the pinned fork,
    # --no-deps to keep this torch, then the fused ops. There is no GPU at
    # build time, so the architectures have to be named: 8.0 A100, 8.6 A40 and
    # RTX 30xx, 8.9 L40S and RTX 40xx, 9.0 H100.
    git clone https://github.com/neel-dey/FireANTs /opt/fireants
    git -C /opt/fireants checkout --quiet c72d2ef485e8622e799deaa4bdd49dd93cee4d1b
    $PIP install --no-cache-dir --no-deps /opt/fireants
    $PIP install --no-cache-dir \
        "SimpleITK>=2.2.1" nibabel scipy scikit-image matplotlib tqdm pandas hydra-core
    export CUDA_HOME=/usr/local/cuda
    export TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0"
    export MAX_JOBS="@MAX_JOBS@"
    $PIP install --no-cache-dir --no-build-isolation /opt/fireants/fused_ops

    # Only the backbone the profiles use is fetched; add others here if needed.
    HF_HOME=/opt/hf /opt/venv/bin/python -c \
        "from anatomix.model.load_from_hf import load_from_hf; load_from_hf('anatomix')"

    chmod -R a+rX /opt

%test
    export PATH=/opt/venv/bin:$PATH HF_HOME=/opt/hf HF_HUB_OFFLINE=1
    python - <<'EOF'
import torch, monai, zarr, SimpleITK, fireants, fireants_fused_ops
from anatomix.model.load_from_hf import load_from_hf
import chunkreg
load_from_hf("anatomix")
# get_arch_list() is empty without a GPU, and a build has none.
arches = torch._C._cuda_getArchFlags()
assert "sm_90" in arches, f"torch has no H100 kernels: {arches}"
print("chunkreg", chunkreg.__version__, "torch", torch.__version__,
      "cuda", torch.version.cuda, "- imports and cached weights OK")
EOF
    chunkreg --version

%runscript
    exec chunkreg "$@"
