#!/bin/bash
# chunkreg on a Grid Engine cluster (UCL CS), inside chunkreg.sif.
#
#   1. build the image once, on a Linux machine:  bash containers/build.sh --help
#   2. edit SETTINGS below and the resource lines in the #$ block
#   3. qsub sge/chunkreg.qsub
#
# Settings can also be overridden at submit time without editing:
#   qsub -v STAGES=run,STOP_AT=200um sge/chunkreg.qsub
#
# Grid Engine has no chunkreg runner, so the whole run happens inside this one
# job: the config must say "runner": "local". With "device": "cuda" the run
# starts one worker per GPU the job holds, so -pe gpu sets how many are used.
#
# A job that hits h_rt is continued by submitting the same script again: setup
# skips what is ingested, and run replays its finished passes and carries on
# from the first one that is missing. The same goes for STOP_AT: stop at 200um,
# look at the result, then submit again with STOP_AT=100um to go finer without
# redoing anything.

# ---- Grid Engine resources ------------------------------------------------
#$ -N chunkreg
#$ -l h_rt=48:00:00                  # walltime
#$ -l gpu=true,gpu_type=h100
#$ -pe gpu 6                         # GPUs; one chunkreg worker on each
#$ -l tmem=48G                       # PER SLOT: multiplied by the slot count above.
#$ -R y
#$ -o /SAN/CHANGE_ME/logs/$JOB_NAME.$JOB_ID.log   # dir must already exist
#$ -S /bin/bash
#$ -cwd
#$ -j y

set -euo pipefail

# ---- SETTINGS -------------------------------------------------------------
# The image built by containers/build.sh. Keep it on shared storage.
SIF="${SIF:-/SAN/CHANGE_ME/images/chunkreg.sif}"
# The run config. Its root and every subject source must be under BINDS.
CONFIG="${CONFIG:-/SAN/CHANGE_ME/chunkreg/run.json}"
# Host directories visible inside the container, comma separated. $HOME and
# the submit directory are bound automatically.
BINDS="${BINDS:-/SAN/CHANGE_ME}"
# Which commands to run, in order: any of setup, run, status.
STAGES="${STAGES:-setup run status}"
# The finest level to run: a spacing such as 200um or a level index. Empty runs
# every level, or whatever levels.stop_at in the config says.
STOP_AT="${STOP_AT:-}"
# Registration engine. Empty uses the config's (fireants on a GPU).
ENGINE="${ENGINE:-}"
# Extra flags, e.g. SETUP_ARGS="--no-probe". RUN_ARGS="--from-level 2" throws
# away the progress at level 2 and finer and redoes it; a plain resubmit resumes.
SETUP_ARGS="${SETUP_ARGS:-}"
RUN_ARGS="${RUN_ARGS:-}"
# Optional: a chunkreg checkout to use instead of the copy baked into the
# image, so code edits do not need a rebuild. Leave empty to use the image.
CHUNKREG_SRC="${CHUNKREG_SRC:-}"
# ---------------------------------------------------------------------------

echo "job ${JOB_ID:-<interactive>} on $(hostname), $(date)"
echo "slots=${NSLOTS:-1} gpus=${CUDA_VISIBLE_DEVICES:-<all visible>}"
echo "sif=$SIF"
echo "config=$CONFIG stages=$STAGES stop_at=${STOP_AT:-<config>} engine=${ENGINE:-<config>}"

[ -f "$SIF" ]    || { echo "FATAL: no image at $SIF; build it with containers/build.sh" >&2; exit 1; }
[ -f "$CONFIG" ] || { echo "FATAL: no config at $CONFIG" >&2; exit 1; }
# Absolute, so they mean the same thing inside the container as outside.
CONFIG="$(cd "$(dirname "$CONFIG")" && pwd -P)/$(basename "$CONFIG")"
if [ -n "$CHUNKREG_SRC" ]; then
    CHUNKREG_SRC="$(cd "$CHUNKREG_SRC" && pwd -P)"
fi

RUNTIME=$(command -v apptainer || command -v singularity) \
    || { echo "FATAL: no apptainer/singularity (try: module load apptainer)" >&2; exit 1; }

# Node-local scratch for the torch, matplotlib and kernel caches — never NFS.
# The image is read-only, and a shared cache written by concurrent jobs corrupts.
export TMPDIR="${TMPDIR:-/tmp/chunkreg.$$}"
CACHE="$TMPDIR/chunkreg-cache"
mkdir -p "$CACHE/torch" "$CACHE/mpl"

# --cleanenv keeps the host's modules and ~/.local out of the image, so what
# the job needs is passed explicitly. Both prefixes: apptainer reads
# APPTAINERENV_*, older SingularityCE reads SINGULARITYENV_*.
pass() { export "APPTAINERENV_$1=$2" "SINGULARITYENV_$1=$2"; }

# The GPUs Grid Engine gave this job, as the GPU prolog set them. Unset inside
# a job means the prolog allocated none ("Not enough GPUs available ...,
# rescheduling job") and the job started anyway. Every card on the node is then
# visible, other people's included, so stop instead of using them. Outside Grid
# Engine, unset means every GPU the container sees is used.
if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
    pass CUDA_VISIBLE_DEVICES "$CUDA_VISIBLE_DEVICES"
elif [ -n "${JOB_ID:-}" ]; then
    echo "FATAL: Grid Engine started this job without allocating it any GPUs" >&2
    echo "  (CUDA_VISIBLE_DEVICES is unset; see the GPU prolog lines above)." >&2
    echo "  Nothing has run. Submit the job again." >&2
    exit 1
fi
pass TMPDIR                "$TMPDIR"
pass XDG_CACHE_HOME        "$CACHE"
pass TORCHINDUCTOR_CACHE_DIR "$CACHE/torch"
pass MPLCONFIGDIR          "$CACHE/mpl"
pass OMP_NUM_THREADS       "${NSLOTS:-1}"
# The image's %environment sets these too; repeating them is cheap insurance
# for a site whose runtime does not source it.
pass PATH                  "/opt/venv/bin:/usr/local/bin:/usr/bin:/bin"
pass HF_HOME               "/opt/hf"
pass HF_HUB_OFFLINE        "1"
pass PYTHONNOUSERSITE      "1"
pass PYTHONUNBUFFERED      "1"

bind="$TMPDIR"
# Bind each directory and, when it is or sits under a symlink (a home-dir link
# into /SAN, say), its real location too; otherwise the link dangles inside.
IFS=, read -r -a bind_dirs <<< "$BINDS"
for d in "${bind_dirs[@]}"; do
    [ -n "$d" ] || continue
    [ -e "$d" ] || { echo "FATAL: BINDS entry $d does not exist" >&2; exit 1; }
    bind="$bind,$d"
    real="$(readlink -f "$d")"
    [ "$real" = "$d" ] || { bind="$bind,$real"; echo "binding $d -> $real"; }
done
if [ -n "$CHUNKREG_SRC" ]; then
    [ -d "$CHUNKREG_SRC/chunkreg" ] \
        || { echo "FATAL: CHUNKREG_SRC=$CHUNKREG_SRC has no chunkreg/ package" >&2; exit 1; }
    bind="$bind,$CHUNKREG_SRC:/opt/chunkreg-dev:ro"
    # Ahead of site-packages, so the checkout wins over the baked-in copy.
    pass PYTHONPATH "/opt/chunkreg-dev"
    echo "using chunkreg source from $CHUNKREG_SRC"
fi

box() { "$RUNTIME" exec --nv --cleanenv --bind "$bind" "$SIF" "$@"; }

# An automounted path (a home-directory mount point, say) can look fine here
# and be empty inside the container. Say so plainly instead of a traceback.
box test -r "$CONFIG" || {
    echo "FATAL: $CONFIG is not visible inside the container. Its directory is" >&2
    echo "  probably an automount the runtime cannot follow; use the real path" >&2
    echo "  (on this cluster /SAN/external/...) in CONFIG, BINDS and the config." >&2
    exit 1
}

# Fail in seconds, not after the queue wait, if the GPU or config is wrong.
box python - "$CONFIG" <<'EOF'
import sys
import torch
import chunkreg
from chunkreg.config import load_config

print(f"chunkreg {chunkreg.__version__} from {chunkreg.__file__}")
if not torch.cuda.is_available():
    sys.exit("FATAL: torch sees no GPU inside the container (is --nv working?)")
n = torch.cuda.device_count()
print(f"torch {torch.__version__}, {n} GPU(s): {torch.cuda.get_device_name(0)}")
# Naming a GPU does not open a context on it, so a card that another process
# holds in exclusive mode only fails later, mid-setup. Open one on each now.
for i in range(n):
    try:
        torch.zeros(1, device=f"cuda:{i}")
    except RuntimeError as exc:
        sys.exit(f"FATAL: GPU {i} of {n} cannot be used: {str(exc).splitlines()[0]}")
cfg = load_config(sys.argv[1])
if cfg.runner != "local":
    sys.exit(
        f"FATAL: {sys.argv[1]} has runner {cfg.runner!r}. Grid Engine jobs run "
        f"everything in this one job, so set \"runner\": \"local\"."
    )
device = getattr(cfg, "device", "auto")
if device not in ("auto", "cuda") and not str(device).startswith("cuda"):
    print(f"WARNING: the config's device is {device!r}; the GPUs will sit idle")
EOF

common=()
[ -n "$STOP_AT" ] && common+=(--stop-at "$STOP_AT")
[ -n "$ENGINE" ] && common+=(--engine "$ENGINE")

for stage in $STAGES; do
    echo
    echo "==== chunkreg $stage  $(date -Is)"
    case "$stage" in
        # shellcheck disable=SC2086  # the *_ARGS are deliberately word-split
        setup)  box chunkreg setup "$CONFIG" ${common[@]+"${common[@]}"} $SETUP_ARGS ;;
        run)    box chunkreg run "$CONFIG" ${common[@]+"${common[@]}"} $RUN_ARGS ;;
        status) box chunkreg status "$CONFIG" ;;
        *)      echo "FATAL: unknown stage '$stage' (use setup, run, status)" >&2; exit 1 ;;
    esac
done

echo
echo "done $(date -Is)"
